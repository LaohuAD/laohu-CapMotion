    "removeStandaloneFillers": true,
    "retakePolicy": "preferLaterComplete"
  },
  "motion": {
    "activeScreenDemo": "avoidOverlay",
    "backdrop": "dimFullFrame",
    "engine": "remotion"
  },
  "schemaVersion": 1
}