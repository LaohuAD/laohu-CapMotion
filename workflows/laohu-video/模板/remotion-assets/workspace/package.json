{
  "name": "laohu-remotion-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Remotion components for spoken-video explanations and motion storytelling.",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.489",
    "@remotion/layout-utils": "4.0.489",
    "@remotion/media": "4.0.489",
    "@remotion/paths": "4.0.489",
    "@remotion/shapes": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@remotion/zod-types": "4.0.489",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.489",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
